#!/usr/bin/env python3
"""Build the compact WordNet-derived glossary bundled with Definition Finder."""

import gzip
import json
import tarfile
from collections.abc import Iterator
from pathlib import Path
from urllib.request import Request, urlopen

import cyclopts


WORDNET_ARCHIVE_URL = "https://unpkg.com/wordnet-db@3.1.12/WNdb-3.1.tar.gz"
PROJECT_ROOT = Path(__file__).resolve().parent.parent
ASSETS_DIRECTORY = PROJECT_ROOT / "src" / "df" / "assets"

app = cyclopts.App(name="build-df-glossary")


@app.default
def build() -> None:
    """Download WordNet 3.1 and generate a compressed, definition-only glossary."""
    request = Request(WORDNET_ARCHIVE_URL, headers={"User-Agent": "df-definition-finder/0.1"})
    with urlopen(request, timeout=60) as response:
        archive_bytes = response.read()
    archive_path = ASSETS_DIRECTORY / "wordnet-source.tar.gz"
    ASSETS_DIRECTORY.mkdir(parents=True, exist_ok=True)
    archive_path.write_bytes(archive_bytes)
    try:
        definitions = _read_wordnet_archive(archive_path)
    finally:
        archive_path.unlink(missing_ok=True)
    with gzip.open(ASSETS_DIRECTORY / "glossary.json.gz", "wt", encoding="utf-8", compresslevel=9) as glossary_file:
        json.dump(definitions, glossary_file, ensure_ascii=False, separators=(",", ":"), sort_keys=True)
    (ASSETS_DIRECTORY / "WORDNET-ATTRIBUTION.md").write_text(
        "This glossary incorporates definition data from Princeton WordNet 3.1. "
        "WordNet is available under the WordNet license; see "
        "https://wordnet.princeton.edu/license-and-commercial-use\n",
        encoding="utf-8",
    )
    size_mb = (ASSETS_DIRECTORY / "glossary.json.gz").stat().st_size / 1_000_000
    print(f"Wrote {len(definitions):,} definitions ({size_mb:.1f} MB compressed).")


def _read_wordnet_archive(archive_path: Path) -> dict[str, str]:
    """Extract one concise gloss per WordNet lemma from its dictionary data files."""
    definitions: dict[str, str] = {}
    with tarfile.open(archive_path, mode="r:gz") as archive:
        for member in archive.getmembers():
            if not member.isfile():
                continue
            member_name = member.name.lower()
            file_handle = archive.extractfile(member)
            if file_handle is None:
                continue
            if "/data." in member_name:
                definitions.update(_read_data_file(line.decode("utf-8", errors="replace") for line in file_handle))
    return definitions


def _read_data_file(lines: Iterator[str]) -> dict[str, str]:
    """Parse WordNet data lines into lowercased lemmas and their first concise gloss."""
    definitions: dict[str, str] = {}
    for line in lines:
        if " | " not in line:
            continue
        record, gloss = line.split(" | ", maxsplit=1)
        fields = record.split()
        if len(fields) < 4:
            continue
        try:
            word_count = int(fields[3], 16)
        except ValueError:
            continue
        word_fields = fields[4 : 4 + (word_count * 2) : 2]
        concise_gloss = gloss.split('; "', maxsplit=1)[0].strip()
        if not concise_gloss:
            continue
        for word in word_fields:
            lemma = word.replace("_", " ").casefold()
            definitions.setdefault(lemma, concise_gloss)
    return definitions


if __name__ == "__main__":
    app()
